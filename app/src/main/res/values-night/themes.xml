<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DLSS5" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/dlss_black</item>
        <item name="android:colorBackground">@color/dlss_black</item>
        <item name="android:statusBarColor">@color/dlss_black</item>
        <item name="android:navigationBarColor">@color/dlss_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="colorAccent">@color/neon_green</item>
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorPrimaryDark">@color/dlss_black</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextHero">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextLabel">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="TextMetric">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="CardNeon">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="ChipNeon" parent="Widget.AppCompat.TextView">
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ButtonNeon">
        <item name="android:background">@drawable/bg_btn_neon</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:shadowColor">@color/neon_green</item>
        <item name="android:shadowRadius">18</item>
        <item name="android:shadowDy">0</item>
    </style>
</resources>
