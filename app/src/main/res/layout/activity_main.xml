<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dlss_black"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.22"
                    android:text="@string/app_name"
                    android:textColor="@color/text_white"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline" />
            </LinearLayout>

            <View
                android:id="@+id/cloudDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/ic_dot" />

            <TextView
                android:id="@+id/cloudLabel"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cloud_offline" />
        </LinearLayout>

        <!-- Permissions banner -->
        <LinearLayout
            android:id="@+id/bannerOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_banner"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bannerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/overlay_permission_required"
                android:textColor="@color/text_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bannerAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_small"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/open_settings"
                android:textColor="@color/neon_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero ring -->
        <com.dlss5.optimizer.ui.NeonRingView
            android:id="@+id/ring"
            android:layout_width="236dp"
            android:layout_height="236dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp" />

        <!-- Engage button -->
        <TextView
            android:id="@+id/btnEngage"
            style="@style/Button.Neon"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="18dp"
            android:text="@string/engage" />

        <TextView
            android:id="@+id/engineHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.04"
            android:text="Overlay runs as a foreground service · nothing leaves your device unless you allow telemetry" />

        <!-- Stats grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Card.Neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_target_fps" />

                <TextView
                    android:id="@+id/statTarget"
                    style="@style/Text.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card.Neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_render_scale" />

                <TextView
                    android:id="@+id/statScale"
                    style="@style/Text.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.70×" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Card.Neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_frame_time" />

                <TextView
                    android:id="@+id/statFrame"
                    style="@style/Text.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- ms" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card.Neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_thermal" />

                <TextView
                    android:id="@+id/statThermal"
                    style="@style/Text.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NONE" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mode chips -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="RENDER MODE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipGovernor"
                style="@style/Chip.Neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_governor" />

            <TextView
                android:id="@+id/chipUpscale"
                style="@style/Chip.Neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/mode_upscale" />

            <TextView
                android:id="@+id/chipTrue"
                style="@style/Chip.Neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/mode_true" />
        </LinearLayout>

        <!-- Toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/toggleSafe"
                style="@style/Chip.Neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/safe_mode" />

            <TextView
                android:id="@+id/toggleTelemetry"
                style="@style/Chip.Neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="TELEMETRY" />
        </LinearLayout>

        <!-- Device card -->
        <LinearLayout
            style="@style/Card.Neon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE PROFILE" />

            <TextView
                android:id="@+id/deviceLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:text="Detecting…" />

            <TextView
                android:id="@+id/configLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/neon_green"
                android:textSize="10sp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- History -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/history_title" />

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/historyEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/no_sessions"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/footerText"
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="DLSS-5 v1.0.0" />
    </LinearLayout>
</ScrollView>
