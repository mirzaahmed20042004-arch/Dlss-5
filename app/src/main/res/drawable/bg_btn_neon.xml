<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_green_24" />
            <corners android:radius="18dp" />
            <stroke android:width="2.5dp" android:color="@color/neon_green" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/dlss_surface" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/neon_green_dim" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dlss_black" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/neon_green" />
        </shape>
    </item>
</selector>
